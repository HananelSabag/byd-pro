<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for whole-widget taps (clipped to the widget shape). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#331E78D8">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/widget_radius"/>
        </shape>
    </item>
</ripple>
