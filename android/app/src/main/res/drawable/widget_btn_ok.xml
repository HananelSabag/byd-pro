<?xml version="1.0" encoding="utf-8"?>
<!-- Widget button (widget_btn_ok): ripple over a rounded pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#331E78D8">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE3EFFC"/>
            <corners android:radius="@dimen/widget_inner_radius"/>
            <stroke android:width="1dp" android:color="#991E78D8"/>
        </shape>
    </item>
</ripple>
