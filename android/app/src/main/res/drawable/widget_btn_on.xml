<?xml version="1.0" encoding="utf-8"?>
<!-- Widget button (widget_btn_on): ripple over a rounded pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#335CC8FF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF132C3D"/>
            <corners android:radius="@dimen/widget_inner_radius"/>
            <stroke android:width="1dp" android:color="#995CC8FF"/>
        </shape>
    </item>
</ripple>
