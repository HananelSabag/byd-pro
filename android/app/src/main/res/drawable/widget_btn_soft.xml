<?xml version="1.0" encoding="utf-8"?>
<!-- Widget button (widget_btn_soft): ripple over a rounded pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#331E78D8">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFDF1E2"/>
            <corners android:radius="@dimen/widget_inner_radius"/>
            <stroke android:width="1dp" android:color="#99B86E00"/>
        </shape>
    </item>
</ripple>
