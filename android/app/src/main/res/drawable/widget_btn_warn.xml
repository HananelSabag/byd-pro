<?xml version="1.0" encoding="utf-8"?>
<!-- Widget button (widget_btn_warn): ripple over a rounded pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#335CC8FF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2E2414"/>
            <corners android:radius="@dimen/widget_inner_radius"/>
            <stroke android:width="1dp" android:color="#99FFB648"/>
        </shape>
    </item>
</ripple>
