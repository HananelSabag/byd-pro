<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 widget, very small cell: the icon alone. Filled in by WidgetRenderer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/w_click"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_ripple"
        android:gravity="center" android:orientation="vertical" android:padding="4dp">

        <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
            <ImageView android:id="@+id/w_disc"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_disc" android:importantForAccessibility="no"/>
            <ProgressBar android:id="@+id/w_progress"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateTint="@color/accent"
                android:visibility="gone"/>
            <ImageView android:id="@+id/w_icon"
                android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center"
                android:src="@drawable/ic_lock" android:tint="@color/text_primary"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
