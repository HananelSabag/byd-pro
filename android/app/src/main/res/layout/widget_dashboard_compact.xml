<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard widget, compact (4x1): battery + four one-tap actions in one row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">

        <LinearLayout android:id="@+id/d_header"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:minWidth="56dp" android:orientation="vertical">
            <TextView android:id="@+id/d_soc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:text="78%" android:textColor="@color/text_primary" android:textSize="20sp"/>
            <TextView android:id="@+id/d_lock"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="@string/state_locked" android:textColor="@color/ok" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal">
        <FrameLayout android:id="@+id/d_btn_lock"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn" android:contentDescription="@string/cmd_lock">
            <ProgressBar android:id="@+id/d_pb_lock"
                android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone"/>
            <ImageView android:id="@+id/d_ic_lock"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_lock" android:tint="@color/text_primary" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/d_btn_unlock"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn" android:contentDescription="@string/cmd_unlock">
            <ProgressBar android:id="@+id/d_pb_unlock"
                android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone"/>
            <ImageView android:id="@+id/d_ic_unlock"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_unlock" android:tint="@color/text_primary" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/d_btn_trunk"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn" android:contentDescription="@string/cmd_trunk">
            <ProgressBar android:id="@+id/d_pb_trunk"
                android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone"/>
            <ImageView android:id="@+id/d_ic_trunk"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_trunk" android:tint="@color/text_primary" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/d_btn_climate"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn" android:contentDescription="@string/cmd_climate">
            <ProgressBar android:id="@+id/d_pb_climate"
                android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone"/>
            <ImageView android:id="@+id/d_ic_climate"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_snowflake" android:tint="@color/text_primary" android:importantForAccessibility="no"/>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
