<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 "charge" widget: picker preview and first frame; WidgetRenderer takes over. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/w_click"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_ripple"
        android:gravity="center" android:orientation="vertical" android:padding="4dp">

        <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
            <ImageView android:id="@+id/w_disc"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_disc" android:importantForAccessibility="no"/>
            <ProgressBar android:id="@+id/w_progress"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateTint="@color/accent"
                android:visibility="gone"/>
            <ImageView android:id="@+id/w_icon"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_bolt" android:tint="@color/text_primary"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView android:id="@+id/w_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:text="@string/w_charge" android:textColor="@color/text_primary" android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
